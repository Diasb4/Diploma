# Operating System Files
.DS_Store
Thumbs.db
desktop.ini
*.directory

# IDE and Editor Configurations
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project

# Environment & Sensitive Data (Strictly forbidden by Commission)
.env
.env.*
!.env.example
secrets/
*.pem
*.key
*.cert
credentials.json

# Python & Virtual Environments (Backend / ML)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# Machine Learning Checkpoints, Large Datasets & Cache
*.pt
*.pth
*.bin
*.onnx
*.safetensors
models/checkpoints/
data/raw/
data/cache/
wandb/
.cache/
huggingface/

# Node.js & Frontend (Web Client)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.next/
out/
.nuxt/
coverage/

# Temporary and Document Auto-Save Files
~$*.docx
~$*.xlsx
~$*.pptx
*.tmp
*.bak
