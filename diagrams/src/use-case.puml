  usecase "UC-06\nSearch and filter\nsupervisors" as UC06
  usecase "UC-07\nView recommended supervisors\nwith match score" as UC07
  usecase "UC-08\nRank preferred supervisors" as UC08
  usecase "UC-09\nView final assignment" as UC09

  usecase "UC-24\nCompute semantic similarity" as UC24
