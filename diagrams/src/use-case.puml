@startuml use-case-overview
' MAS-13: Use Case diagrams for the Multi-Criteria Assignment System.
' This file holds four diagrams: an overview and one detailed view per actor.
' Use case labels carry the requirement IDs from docs/06-requirements-spec.md.

title MAS: Use Case Overview

left to right direction
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ArrowColor Black
skinparam usecase {
  BackgroundColor White
  BorderColor Black
}
skinparam actor {
  BackgroundColor White
  BorderColor Black
}

actor "Student" as Student
actor "Supervisor" as Supervisor
actor "Department\nCoordinator" as Coordinator

rectangle "Multi-Criteria Assignment System (MAS)" {
  usecase "Log in\n(FR-01)" as LOGIN

  usecase "Submit thesis proposal\n(FR-02)" as S1
  usecase "View recommended supervisors\n(FR-05)" as S2
  usecase "Submit ordered preference list\n(FR-06)" as S3
  usecase "View published result\n(FR-10)" as S4

  usecase "Maintain research profile\nand propose capacity\n(FR-03)" as P1
  usecase "View own published assignments\n(FR-10)" as P2

  usecase "Set up allocation cycle\n(FR-03, FR-04, FR-07)" as C1
  usecase "Run batch allocation\n(FR-08)" as C2
  usecase "Review and revise draft\n(FR-09, FR-13)" as C3
  usecase "Publish and export result\n(FR-10, FR-11)" as C4
  usecase "View audit log\n(FR-12)" as C5
}

Student --> LOGIN
Supervisor --> LOGIN
Coordinator --> LOGIN

Student --> S1
Student --> S2
Student --> S3
Student --> S4

Supervisor --> P1
Supervisor --> P2

Coordinator --> C1
Coordinator --> C2
Coordinator --> C3
Coordinator --> C4
Coordinator --> C5
@enduml

@startuml use-case-student
title MAS: Student Use Cases

left to right direction
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ArrowColor Black
skinparam usecase {
  BackgroundColor White
  BorderColor Black
  BackgroundColor<<proposed>> #EEEEEE
}
skinparam actor {
  BackgroundColor White
  BorderColor Black
}

actor "Student" as Student

rectangle "MAS: Student scenarios" {
  usecase "UC-01\nLog in\n(FR-01)" as UC01
  usecase "UC-02\nCreate, edit and submit\nthesis proposal\n(FR-02)" as UC02
  usecase "UC-03\nView recommended supervisors\n(up to five, FR-05)" as UC03
  usecase "UC-04\nView supervisor profile\n(no FR yet)" as UC04 <<proposed>>
  usecase "UC-05\nSubmit and reorder preference list\n(1 to 5 supervisors, FR-06)" as UC05
  usecase "UC-06\nView published result\n(FR-10)" as UC06

  usecase "UC-23\nValidate deadline and eligibility" as UC23
  usecase "UC-24\nCompute semantic similarity" as UC24
}

Student --> UC01
Student --> UC02
Student --> UC03
Student --> UC05
Student --> UC06

UC02 ..> UC23 : <<include>>
UC05 ..> UC23 : <<include>>
UC03 ..> UC24 : <<include>>

UC04 ..> UC03 : <<extend>>

note right of UC03
  Available after the proposal
  is submitted. The score is a
  similarity score in [0, 1].
end note
@enduml

