@startuml use-case-overview
' MAS-7b: Use Case diagrams for the Multi-Criteria Assignment System.
' This file holds four diagrams: an overview and one detailed view per actor.

title MAS: Use Case Overview

left to right direction
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ArrowColor Black
skinparam usecase {
  BackgroundColor White
  BorderColor Black
}
skinparam actor {
  BackgroundColor White
  BorderColor Black
}

actor "Student" as Student
actor "Supervisor" as Supervisor
actor "Department\nCoordinator" as Coordinator

rectangle "Multi-Criteria Assignment System (MAS)" {
  usecase "Log in with university email" as LOGIN

  usecase "Maintain academic profile\nand thesis proposal" as S1
  usecase "Get supervisor recommendations" as S2
  usecase "Rank preferred supervisors" as S3
  usecase "View final assignment" as S4

  usecase "Maintain research profile\nand publications" as P1
  usecase "Set student quota" as P2
  usecase "Review applicants" as P3

  usecase "Configure cycle, quotas\nand scoring weights" as C1
  usecase "Run automatic assignment" as C2
  usecase "Review and adjust results" as C3
  usecase "Publish and export assignments" as C4
}

Student --> LOGIN
Supervisor --> LOGIN
Coordinator --> LOGIN

Student --> S1
Student --> S2
Student --> S3
Student --> S4

Supervisor --> P1
Supervisor --> P2
Supervisor --> P3

Coordinator --> C1
Coordinator --> C2
Coordinator --> C3
Coordinator --> C4
@enduml

